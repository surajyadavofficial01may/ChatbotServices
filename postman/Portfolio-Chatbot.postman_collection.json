{
  "info": {
    "name": "Portfolio AI Chatbot API",
    "description": "Endpoint tests for the portfolio RAG backend.\n\nSetup:\n1. Set the collection variable `adminToken` to the ADMIN_API_TOKEN from your .env and `webhookSecret` to WEBHOOK_SECRET (both left empty here on purpose).\n2. Change `baseUrl` if the server is not on http://127.0.0.1:8000.\n3. Run '2. Admin sync' once before the chat requests — chat answers 'not available' until the index exists.\n\nRunning the whole collection in the Collection Runner: set a delay of ~8000 ms between requests. Each chat request is one Groq call and the free tier allows ~8k tokens/minute; the API also rate-limits /chat/ask to 30 requests/minute per IP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "webhookSecret",
      "value": ""
    },
    {
      "key": "frontendOrigin",
      "value": "http://localhost:5173"
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Root",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Basic health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('healthy', () => pm.expect(pm.response.json()).to.eql({ status: 'healthy' }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Detailed health (dependencies + retrieval models)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Supabase configured', () => pm.expect(body.dependencies.supabase).to.be.true);",
                  "pm.test('Qdrant configured', () => pm.expect(body.dependencies.qdrant).to.be.true);",
                  "pm.test('LLM provider set', () => pm.expect(body.dependencies.llm_provider).to.be.a('string'));",
                  "pm.test('retrieval models reported', () => pm.expect(body.retrieval).to.have.all.keys('embedding_model', 'sparse_model', 'reranker_model'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/health"
          }
        },
        {
          "name": "Chat status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ready', () => pm.expect(pm.response.json().status).to.eql('ready'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/chat/status"
          }
        },
        {
          "name": "Request ID is echoed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('X-Request-ID echoed back', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.eql('postman-trace-1'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "postman-trace-1"
              }
            ],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "2. Admin sync",
      "item": [
        {
          "name": "Sync without token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/admin/sync"
          }
        },
        {
          "name": "Sync with wrong token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-token",
                "value": "definitely-wrong"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/sync"
          }
        },
        {
          "name": "Sync (Supabase -> Qdrant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('sync succeeded', () => pm.expect(body.success, body.error).to.be.true);",
                  "pm.test('report has counts', () => pm.expect(body).to.include.keys('added', 'updated', 'removed', 'unchanged', 'reindexed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-token",
                "value": "{{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/sync"
          }
        },
        {
          "name": "Sync again -> nothing changes (idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('sync succeeded', () => pm.expect(body.success, body.error).to.be.true);",
                  "pm.test('no records re-embedded', () => { pm.expect(body.added).to.eql(0); pm.expect(body.updated).to.eql(0); });",
                  "pm.test('all records unchanged', () => pm.expect(body.unchanged).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-token",
                "value": "{{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/sync"
          }
        }
      ]
    },
