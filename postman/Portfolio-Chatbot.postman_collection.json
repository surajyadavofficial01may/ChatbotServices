    {
      "name": "6. CORS preflight",
      "item": [
        {
          "name": "Allowed frontend origin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('origin allowed', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.collectionVariables.get('frontendOrigin')));"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              }
            ],
            "url": "{{baseUrl}}/api/v1/chat/ask"
          }
        },
        {
          "name": "Unknown origin is not allowed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('no Access-Control-Allow-Origin header', () => pm.expect(pm.response.headers.has('Access-Control-Allow-Origin')).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "https://evil.example"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              }
            ],
            "url": "{{baseUrl}}/api/v1/chat/ask"
          }
        }
      ]
    }
  ]
}
