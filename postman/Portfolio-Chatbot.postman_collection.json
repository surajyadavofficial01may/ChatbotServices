    {
      "name": "3. Chat — answerable questions",
      "item": [
        {
          "name": "Factual: CGPA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const squashed = body.answer.replace(/\\s+/g, '');",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('answer contains 8.35', () => pm.expect(squashed).to.include('8.35'));",
                  "pm.test('answer cites a source', () => pm.expect(body.answer).to.match(/\\[1\\]/));",
                  "pm.test('cited sources returned', () => pm.expect(body.sources.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What was Suraj's CGPA?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/chat/ask"
          }
        },
