# =============================================================================
# AI Knowledge Assistant — configuration
# Copy to .env and fill in the REQUIRED values. Never commit .env.
# Step-by-step instructions for every key: README.md -> "Get your credentials".
# (Comments must stay on their own lines: `docker run --env-file` doesn't strip them.)
# =============================================================================

# --- REQUIRED ----------------------------------------------------------------

# Groq (LLM): console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant Cloud (vector search): cloud.qdrant.io -> Clusters -> your cluster.
# URL looks like https://xxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io:6333
# The collection is created automatically on the first sync.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge_base

# Supabase (source of truth): Project Settings -> API. URL looks like https://abcdefghijkl.supabase.co
# Use the service_role key (or a new sb_secret_ key). It bypasses Row Level Security:
# keep it on the server only, never in a browser or app.
# The table name must match supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE_NAME=portfolio_knowledge_base

# Password for the /dataentry admin studio and the /api/v1/admin/* API.
# Use a long random value: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=

# --- ASSISTANT ---------------------------------------------------------------

APP_TITLE=AI Knowledge Assistant
# Who the assistant is and how it speaks. Grounding and safety rules are always appended.
ASSISTANT_PERSONA=You are a helpful assistant that answers questions about the topics covered by this knowledge base.
# Exact reply when the knowledge base has no answer.
NO_ANSWER_MESSAGE=That information is not available in the knowledge base.

# --- WEB & SECURITY ----------------------------------------------------------

# Comma-separated origins allowed to call the chat API from a browser.
# "*" = any website can embed it (convenient; the chat is rate-limited per IP).
# Lock it down in production, e.g. https://www.example.com,https://example.com
ALLOWED_ORIGINS=*
# Chat requests per client IP per minute.
RATE_LIMIT_PER_MINUTE=30
# Optional: lets automation (GitHub Actions, Supabase webhooks) trigger a sync via
# POST /api/v1/webhook/sync with header X-Webhook-Secret. Empty = webhook disabled.
WEBHOOK_SECRET=
SYNC_ENABLED=true

# --- RETRIEVAL (defaults are benchmarked; see docs/) ----------------------------
# Local FastEmbed models: no API key needed. Changing EMBEDDING_MODEL, SPARSE_MODEL,
# EMBEDDING_QUERY_PREFIX or CHUNK_SIZE re-embeds everything on the next sync.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Unset = the model's documented query prefix.
# EMBEDDING_QUERY_PREFIX=
# Empty = dense-only search.
SPARSE_MODEL=Qdrant/bm25
# Optional cross-encoder, e.g. Xenova/ms-marco-MiniLM-L-6-v2 (adds ~380 MB RAM).
RERANKER_MODEL=
# Characters per chunk for long entries.
CHUNK_SIZE=1200
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=5
RETRIEVAL_LIST_TOP_K=10
RRF_K=60
RETRIEVAL_SCORE_THRESHOLD=0.45
RERANK_SCORE_THRESHOLD=-11.0
MAX_CONTEXT_TOKENS=3000

# --- LLM BEHAVIOUR -----------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
HISTORY_MAX_TURNS=6

# --- RUNTIME -----------------------------------------------------------------
# production = INFO logs, Secure cookies, no auto-reload.
APP_ENV=development
API_PREFIX=/api/v1
# true adds the retrieval trace to chat responses (development only).
RAG_DEBUG=false
# Warm the embedding models in the background at startup.
PRELOAD_MODELS=true
