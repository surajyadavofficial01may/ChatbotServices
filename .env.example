# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development
APP_NAME=Portfolio AI Chatbot
API_PREFIX=/api/v1
# Comma-separated origins allowed to call the API from a browser
FRONTEND_ORIGINS=http://localhost:5173

# --- Knowledge base source (Supabase Storage) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Vector database (Qdrant Cloud) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=portfolio_knowledge

# --- LLM provider: groq or gemini ---
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# --- Security ---
# Long random strings, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
WEBHOOK_SECRET=
SYNC_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# --- Retrieval models (changing any of these re-embeds everything on the next sync) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=

# --- Retrieval tuning (defaults are the benchmarked production values) ---
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=5
RETRIEVAL_LIST_TOP_K=10
RRF_K=60
RETRIEVAL_SCORE_THRESHOLD=0.45
RERANK_SCORE_THRESHOLD=-11.0
MAX_CONTEXT_TOKENS=3000

# --- Behaviour ---
HISTORY_MAX_TURNS=6
RAG_DEBUG=false
PRELOAD_MODELS=true
